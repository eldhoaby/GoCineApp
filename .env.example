# ============================================
# GoCine — Environment Variables Template
# ============================================
# Copy this file to the appropriate directory:
#   backend/.env   — for backend configuration
#   frontend/.env  — for frontend configuration
# ============================================

# ----- Backend Configuration -----

# Server port (default: 3000)
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gocine

# Razorpay credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ----- Frontend Configuration -----

# Backend API URL (for local development)
VITE_API_URL=http://localhost:3000

# Razorpay public key (frontend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
